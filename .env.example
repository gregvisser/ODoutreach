# =============================================================================
# Copy to .env locally. NEVER commit .env — only this file is tracked.
#
# Microsoft Entra (Azure AD) — app registration + client secret; set redirect URI:
#   https://<your-host>/api/auth/callback/microsoft-entra-id
#
# Where to set values:
#   Local: .env (gitignored)
#   Azure App Service: Configuration → Application settings
#   GitHub CI: workflow env (placeholders) — see .github/workflows/ci.yml
# =============================================================================

# --- Core ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/opensdoors_outreach?schema=public"

# --- Auth.js / NextAuth (Microsoft Entra ID) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Base URL of this app (Auth.js uses this for OAuth redirects). Local: http://localhost:3000
AUTH_URL="http://localhost:3000"
# Paste from Entra app registration → Overview: Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_ID=""
# Paste client secret value (Certificates & secrets — not the secret ID)
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Single-tenant:
#   https://login.microsoftonline.com/<TENANT_ID>/v2.0/
# Multi-tenant (workforce sign-in from more than one Entra directory):
#   https://login.microsoftonline.com/common/v2.0
#   (or /organizations/v2.0) — then you MUST set ALLOWED_ENTRA_TENANT_IDS.
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# When using /common/ or /organizations/ as the issuer, list every
# directory (tenant) UUID allowed to sign in (e.g. Bidlow + OpensDoors).
# Comma-separated, lowercase or mixed. Empty with a multi-tenant issuer
# means no-one can sign in.
ALLOWED_ENTRA_TENANT_IDS=""

# --- In-app staff invitations (Microsoft Graph, client credentials) ---
# Uses the same Entra app as Auth.js. In Entra: API permissions → Microsoft Graph → Application:
#   User.Invite.All, User.Read.All — then Grant admin consent.
# Token uses AUTH_MICROSOFT_ENTRA_ID_ID + AUTH_MICROSOFT_ENTRA_ID_SECRET and tenant from issuer.
# Optional explicit tenant GUID if issuer parsing is insufficient:
# AUTH_TENANT_ID=""
# Optional override for guest redemption landing (default: AUTH_URL + /sign-in):
# STAFF_INVITE_REDIRECT_URL="https://opensdoors.bidlow.co.uk/sign-in"

# --- First Azure staging deploy (typical minimum beyond core + auth) ---
PROCESS_QUEUE_SECRET=""
INTERNAL_APP_URL="http://localhost:3000"
AUTOPROCESS_OUTBOUND_QUEUE="true"
# Comma-separated; only staff whose email ends with these domains may use the UI when set.
# For real Entra verification use your org domains, e.g. bidlow.co.uk,opensdoors.co.uk
# Leave empty only for quick local UI work without domain gating.
STAFF_EMAIL_DOMAINS=""

# --- Email (optional until real ESP) ---
EMAIL_PROVIDER="mock"
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""

# --- Mailbox OAuth (Microsoft 365 / Google Workspace) — separate from staff Entra SSO ---
# Encrypts stored refresh tokens; use a long random value (e.g. openssl rand -base64 32).
# Falls back to AUTH_SECRET if unset (not recommended for production).
MAILBOX_OAUTH_SECRET=""
# Azure AD app registration for delegated mailbox access (not the same redirect URIs as Auth.js staff login).
# Register redirect: {AUTH_URL}/api/mailbox-oauth/microsoft/callback
MAILBOX_MICROSOFT_OAUTH_CLIENT_ID=""
MAILBOX_MICROSOFT_OAUTH_CLIENT_SECRET=""
# Tenant segment for authorize/token URLs: common | organizations | your tenant GUID
MAILBOX_MICROSOFT_OAUTH_TENANT="common"
# Google Cloud OAuth client (Desktop or Web). Register redirect: {AUTH_URL}/api/mailbox-oauth/google/callback
MAILBOX_GOOGLE_OAUTH_CLIENT_ID=""
MAILBOX_GOOGLE_OAUTH_CLIENT_SECRET=""

# --- Azure Maps (server-side) — UK Brief business address search ---
# Get a subscription key (Azure portal → your Maps account → Authentication).
# Set on App Service as an Application setting. Never expose this key in the client bundle.
AZURE_MAPS_SUBSCRIPTION_KEY=""

# --- Optional product integrations ---
# Google service account JSON — used for Suppression list sync from Google
# Sheets (Settings → Integrations). project_id is also read from this JSON to
# build the Settings link to the OAuth consent screen test users page.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=""
ROCKETREACH_API_KEY=""
# Set to "1" or "true" only when debugging — shows Raw JSON import on client Sources (not for normal staff).
ROCKETREACH_IMPORT_JSON_DEBUG=""
# Seed: Entra object id (oid claim) for the demo StaffUser row — optional if you set seed email to your work address (first login links oid by email).
SEED_ENTRA_OBJECT_ID=""

# --- Outbound / inbound tuning ---
DEFAULT_OUTBOUND_FROM=""
ALLOWED_SENDER_EMAIL_DOMAINS=""
INBOUND_WEBHOOK_SECRET=""
OUTBOUND_QUEUE_BATCH_SIZE="8"
MAX_OUTBOUND_SEND_RETRIES="5"
# H1/H2 — preflight de-dup for governed (Gmail/Graph) sends. When "true", a
# retried send first asks the provider whether the message already landed and
# reconciles to SENT instead of re-sending (prevents a duplicate after a crash
# in the accept->DB-write window). Default OFF — leave empty/false until verified.
SEND_PREFLIGHT_DEDUP_ENABLED=""
# Audit M5/M6 — when "true", the definitive thread-ref reply match also requires
# the sender to be the address we emailed (toEmail == from), so a forwarded/CC'd
# third party on the thread can't halt the prospect's sequence. Default OFF.
REPLY_THREAD_REF_SENDER_GUARD=""

# --- Deliverability controls (operational; both default OFF) ---
#
# Detect hard bounces on the LIVE mailbox send path. Microsoft Graph and Gmail
# give us no delivery webhook, so the only bounce signal is the NDR / DSN
# bounce-back that lands back in the connected mailbox. When this is "true",
# inbox sync parses those and suppresses the failed recipient.
#
# OFF MEANS BLIND. Not "bounces are handled elsewhere" -- nothing measures the
# bounce rate at all, and the reported rate will sit at 0% no matter how many
# addresses are failing. The cold-email non-negotiable is a bounce rate under
# 2%, and a threshold nobody can measure cannot be enforced. Turn this on
# before sending to real prospects.
MAILBOX_BOUNCE_DETECTION_ENABLED=""

# Ramp a new mailbox up instead of letting it send at its full daily cap from
# day one. Set to exactly "on" to enable. Starts at 5 sends/day and adds 5
# every 5 days, per mailbox, based on mailbox age.
#
# OFF means a brand-new mailbox may send at its full steady cap immediately,
# which is the single fastest way to burn a sending domain's reputation.
MAILBOX_WARMUP_RAMP=""

# Spread each mailbox's daily allowance across working hours instead of letting
# it empty into the first cron run of the morning.
#
# THIS IS NOW ON BY DEFAULT. Leave it blank/unset for on. It is an OFF-switch:
# set it to "false" (or "off"/"0"/"no") to disable pacing. It shipped default-off,
# was never set in production, and therefore never ran once - the same shape as
# the NDR bounce detector that sat unused for 36 days. A flag nobody sets is not
# a feature.
#
# Thirty emails in ninety seconds is not a person, and Microsoft's hard limit is
# 30 messages per MINUTE per mailbox - a burst of a day's allowance sits right on
# that line. With this ON, sends leave in small GROUPS - four at a time by
# default - with a real gap before the next group, spread across 07:00-18:00 with
# modest jitter and a per-mailbox offset, and steered off the :00/:15/:30/:45 ISP
# peak marks. The group size is set PER CLIENT on the workspace's Mailboxes tab
# (Client.sendBatchSize); blank there means the house default of 4.
#
# It NEVER raises a cap. It only withholds part of the day's allowance until
# later in the day, and yields the full allowance once the window closes at
# 18:00 UTC - the outbound cron runs until 18:55, so nothing is stranded.
#
# OFF MEANS BURSTS. At 5/day that barely matters; at 30/day it is the single most
# obvious machine signature there is.
MAILBOX_SEND_PACING=""

# --- Dev-only routes (omit on Azure staging unless needed) ---
OUTBOUND_DEV_QUEUE_SECRET=""
ALLOW_DEV_OUTBOUND_QUEUE=""
OUTBOUND_DEV_PROVIDER_EVENT_SECRET=""
ALLOW_DEV_PROVIDER_SIMULATE=""
OUTBOUND_DEV_WEBHOOK_REPLAY_SECRET=""
ALLOW_DEV_WEBHOOK_REPLAY=""
INBOUND_DEV_SIMULATE_SECRET=""
ALLOW_DEV_INBOUND_SIMULATE=""

# ── Autonomous relay safety gate ──────────────────────────────────────────────
# Set ONLY while an unattended agent is operating this repo. While active, any
# send with no signed-in member of staff behind it is refused unless the client
# is allowlisted below. A send launched by a person is never affected.
#
# Leave BOTH unset in normal operation — the gate is then completely inert.
# If ACTIVE is on and the allowlist is empty, EVERY machine send is refused.
# That is the gate failing closed and is correct, not a misconfiguration to fix
# by clearing the variable.
AUTONOMOUS_RELAY_ACTIVE=
AUTONOMOUS_SEND_ALLOWLIST=bidlowai

# Let a NEAR-CERTAIN related-domain match block a domain without asking anyone.
# Set to "true" / "1" / "on" / "yes" to enable. DEFAULT OFF.
#
# What "near-certain" means, and it is narrow: the two domains are verified
# domains of the SAME Microsoft 365 tenant (which only happens when one
# organisation controls both), neither is a consumer mailbox provider, no other
# company on the list shares that tenant, and the block would remove no more
# than 25 contacts. DMARC and SPF matches are NEVER auto-blocked, however clean.
#
# OFF means every match is raised as a question on the client's do-not-contact
# page and blocks nothing until somebody clicks. That is the behaviour the
# product shipped with, and reversing it is a commercial decision, not a
# technical one: an automatic block silently removes prospects from a paying
# client's universe. Run `npm run ops:family-proposals` against production
# first -- it prints exactly how many domains and contacts this would remove
# before you turn it on. Blocks are undoable from the do-not-contact page and
# are labelled there as automatic.
SUPPRESSION_TENANT_AUTO_BLOCK_ENABLED=""
