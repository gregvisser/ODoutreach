{
  "_comment": "PROPOSED CONTENT FOR .claude/settings.json - NOT INSTALLED. See INSTALL-DENY-LIST.md next to this file. An agent is deliberately not allowed to write its own hook configuration, so this needs Greg's hand once.",
  "permissions": {
    "deny": [
      "Bash(sudo rm:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -fr /:*)",
      "Bash(rm -fr ~:*)",
      "Bash(git push --force origin main:*)",
      "Bash(git push -f origin main:*)",
      "Bash(git push --force-with-lease origin main:*)",
      "Bash(dropdb:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(prisma migrate reset:*)",
      "Bash(npm run db:migrate:reset:*)",
      "Bash(az group delete:*)",
      "Bash(az webapp delete:*)",
      "Bash(az postgres flexible-server delete:*)",
      "Bash(az postgres server delete:*)",
      "Bash(az resource delete:*)",
      "Bash(az storage account delete:*)",
      "Bash(az keyvault delete:*)",
      "Bash(az keyvault purge:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/relay/deny-irreversible-hook.mjs\""
          }
        ]
      }
    ]
  }
}
