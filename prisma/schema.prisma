// OpensDoors — cold outreach platform (multi-tenant)
// All tenant-owned data references Client (tenant) for strict isolation.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ——— Enums ———

enum StaffRole {
  ADMIN
  MANAGER
  OPERATOR
  VIEWER
}

/// Tracks Microsoft Graph B2B guest invitation lifecycle for staff provisioned from the app.
enum StaffGuestInvitationState {
  NONE
  PENDING
  ACCEPTED
}

enum ClientLifecycleStatus {
  ONBOARDING
  ACTIVE
  PAUSED
  ARCHIVED
}

/// Commercial handling tier for a client account. CORPORATE is the VIP tier and
/// is the only one that changes behaviour today: its outreach is released to
/// staff four recipients at a time (see `@/lib/outreach/manual-send-window`).
/// MID and STANDARD are recorded for commercial reporting and behave alike.
enum ClientAccountGrade {
  CORPORATE
  MID
  STANDARD
}

/// PR K — Launch approval mode recorded alongside `Client.launchApprovedAt`.
/// CONTROLLED_INTERNAL: approved for staff/allowlisted recipient pilots only
/// (current operational mode; does not require one-click unsubscribe).
/// LIVE_PROSPECT: approved for live prospect outreach — requires one-click
/// unsubscribe readiness which is not yet implemented, so this mode is not
/// selectable from the UI until a future PR wires it up.
enum ClientLaunchApprovalMode {
  CONTROLLED_INTERNAL
  LIVE_PROSPECT
}

enum ClientMemberRole {
  LEAD
  CONTRIBUTOR
  VIEWER
}

enum ContactSource {
  CSV_IMPORT
  ROCKETREACH
  MANUAL
}

/// Global contact warehouse source attribution (CSV / RocketReach / manual).
enum UniverseSourceType {
  CSV_IMPORT
  ROCKETREACH
  MANUAL
  OTHER
}

enum ImportBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum RocketReachJobStatus {
  PENDING
  FETCHED
  FAILED
  STALE
}

enum SuppressionListKind {
  EMAIL
  DOMAIN
}

enum SuppressionSyncStatus {
  NOT_CONFIGURED
  IDLE
  SYNCING
  SUCCESS
  ERROR
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
}

/// Per-client email template category (PR D4a). Each template fills one
/// slot in the introduction → follow-up ladder. Sequences (PR D4b+) pick
/// one template per step.
enum ClientEmailTemplateCategory {
  INTRODUCTION
  FOLLOW_UP_1
  FOLLOW_UP_2
  FOLLOW_UP_3
  FOLLOW_UP_4
  FOLLOW_UP_5
}

/// Approval lifecycle for a client email template (PR D4a). Only
/// APPROVED templates are eligible for future sequence selection; DRAFT
/// and READY_FOR_REVIEW are editable; ARCHIVED is a soft-delete that
/// keeps history.
enum ClientEmailTemplateStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  ARCHIVED
}

/// Approval lifecycle for a client email sequence (PR D4b). Mirrors the
/// template lifecycle so the same mental model applies: DRAFT while the
/// operator composes it, READY_FOR_REVIEW once it is complete, APPROVED
/// once OpensDoors staff sign off, ARCHIVED as a soft-delete. APPROVED
/// is a record-only marker in D4b — no send/schedule logic is wired to
/// it yet.
enum ClientEmailSequenceStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  ARCHIVED
}

/// PR D4c — per-contact enrollment lifecycle. Records-only in this
/// PR: there is no scheduler or step-send worker attached. PAUSED is
/// intended as an operator-initiated hold. EXCLUDED is reserved for
/// a future "preserve excluded row for visibility" path — today the
/// enrollment writer skips ineligible contacts with counts rather
/// than persisting EXCLUDED rows.
enum ClientEmailSequenceEnrollmentStatus {
  PENDING
  PAUSED
  COMPLETED
  EXCLUDED
}

/// PR D4e.1 — per-step send-planning lifecycle. RECORDS ONLY in this
/// PR: no send execution, no reservation, no OutboundEmail creation
/// from this status. The worker that consumes READY rows lands in
/// D4e.2 behind the allowlist gate.
///
///   * PLANNED    — row created; composition / readiness not yet
///                  evaluated.
///   * READY      — composition succeeded, recipient email present,
///                  template APPROVED, no suppression — eligible for
///                  D4e.2 to later convert into an OutboundEmail.
///   * SKIPPED    — operator/policy opted out of this step for this
///                  enrollment (e.g. enrollment was EXCLUDED).
///   * SUPPRESSED — recipient email is currently suppressed
///                  (per-tenant suppression rules).
///   * BLOCKED    — non-suppression readiness failure (missing email,
///                  unknown placeholder, template not approved,
///                  missing unsubscribe link, wrong client, etc.).
///                  `blockedReason` carries the detail.
///   * SENT       — (D4e.2+) step-send was actually dispatched and is
///                  now linked to an `OutboundEmail`. Never written
///                  in D4e.1.
///   * FAILED     — (D4e.2+) terminal composition/dispatch failure.
///                  Never written in D4e.1.
enum ClientEmailSequenceStepSendStatus {
  PLANNED
  READY
  SKIPPED
  SUPPRESSED
  BLOCKED
  SENT
  FAILED
}

enum OutboundEmailStatus {
  /// Legacy — prefer REQUESTED for new rows
  PREPARING
  /// Validated send request; not yet in worker pool
  REQUESTED
  /// Eligible for outbound worker (provider send not yet completed)
  QUEUED
  /// Worker claimed — provider API call in flight
  PROCESSING
  /// Suppression check failed — never sent
  BLOCKED_SUPPRESSION
  /// Provider accepted the message (API success)
  SENT
  /// Terminal provider/transport failure (may be retried → back to QUEUED)
  FAILED
  /// Bounce reported by provider webhook
  BOUNCED
  DELIVERED
  /// Inbound reply linked to this send (operational milestone)
  REPLIED
}

enum InboundMatchMethod {
  UNLINKED
  BY_OUTBOUND_PROVIDER_ID
  BY_THREAD_REF
  BY_CONTACT_EMAIL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  SYNC
  IMPORT
}

/// Workspace sender readiness (not full DNS UI — operational gating)
enum SenderIdentityStatus {
  NOT_SET
  CONFIGURED_UNVERIFIED
  VERIFIED_READY
}

/// Outreach mailbox provider (Microsoft 365 vs Google Workspace)
enum MailboxProvider {
  MICROSOFT
  GOOGLE
}

/// OAuth / connection lifecycle for a client mailbox identity (records-only in early slices)
enum MailboxConnectionStatus {
  DRAFT
  PENDING_CONNECTION
  CONNECTED
  CONNECTION_ERROR
  DISCONNECTED
}

/// Per-mailbox send reservation / cap ledger (UTC day window) — for duplicate-safe bookings before worker send.
enum MailboxSendReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

// ——— Staff (Microsoft Entra object id — oid claim) ———

model StaffUser {
  id                       String                    @id @default(cuid())
  entraObjectId            String                    @unique
  /// Normalized (lowercase/trim) — unique so first-login can match by email then attach entraObjectId
  email                    String                    @unique
  displayName              String?
  role                     StaffRole                 @default(OPERATOR)
  isActive                 Boolean                   @default(true)
  /// F2 — super-admin capability (delete/purge a workspace). Gated per
  /// account, NOT by email string. Assigned to greg@bidlow.co.uk.
  isSuperAdmin             Boolean                   @default(false)
  guestInvitationState     StaffGuestInvitationState @default(NONE)
  invitedAt                DateTime?
  invitationLastSentAt     DateTime?
  invitedById              String?
  invitedBy                StaffUser?                @relation("StaffInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedStaff             StaffUser[]               @relation("StaffInvitedBy")
  /// Microsoft Graph invitation resource id (from POST /invitations)
  graphInvitationId        String?                   @unique
  /// Object id of the invited guest user in the tenant (from invitation response)
  graphInvitedUserObjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships                     ClientMembership[]
  auditLogs                       AuditLog[]
  outboundSends                   OutboundEmail[]                  @relation("OutboundInitiator")
  mailboxIdentitiesCreated        ClientMailboxIdentity[]          @relation("MailboxIdentityCreatedBy")
  mailboxesWorkspaceRemoved       ClientMailboxIdentity[]          @relation("MailboxIdentityWorkspaceRemovedBy")
  contactListsCreated             ContactList[]                    @relation("ContactListCreatedBy")
  contactListMembersAdded         ContactListMember[]              @relation("ContactListMemberAddedBy")
  emailTemplatesCreated           ClientEmailTemplate[]            @relation("ClientEmailTemplateCreatedBy")
  emailTemplatesApproved          ClientEmailTemplate[]            @relation("ClientEmailTemplateApprovedBy")
  emailSequencesCreated           ClientEmailSequence[]            @relation("ClientEmailSequenceCreatedBy")
  emailSequencesApproved          ClientEmailSequence[]            @relation("ClientEmailSequenceApprovedBy")
  sequenceEnrollmentsCreated      ClientEmailSequenceEnrollment[]  @relation("ClientEmailSequenceEnrollmentCreatedBy")
  sequenceStepSendsCreated        ClientEmailSequenceStepSend[]    @relation("ClientEmailSequenceStepSendCreatedBy")
  clientsLaunchApproved           Client[]                         @relation("ClientLaunchApprovedBy")
  clientsAccountGradeSet          Client[]                         @relation("ClientAccountGradeSetBy")
  clientsAutonomousSendSet        Client[]                         @relation("ClientAutonomousSendSetBy")
  clientsAsBriefAccountManager    Client[]                         @relation("ClientBriefAccountManager")
  clientComplianceFilesUploaded   ClientComplianceAttachment[]     @relation("ClientComplianceUpload")
  supportTicketsCreated           SupportTicket[]                  @relation("SupportTicketCreatedBy")
  supportTicketsApproved          SupportTicket[]                  @relation("SupportTicketApprovedBy")
  suppressedDomainFamiliesCreated SuppressedDomainFamily[]         @relation("SuppressedDomainFamilyCreatedBy")
  familyProposalsDecided          SuppressedDomainFamilyProposal[] @relation("FamilyProposalDecidedBy")
  replyClaims                     ReplyClaim[]

  @@index([invitedById])
}

/// Staff-raised support ticket for issues with the ODoutreach system itself
/// (not client outreach). Workspace-wide, not client-scoped.
enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  AWAITING_APPROVAL
  APPROVED
  RESOLVED
  REJECTED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model SupportTicket {
  id                    String                @id @default(cuid())
  /// Short one-line summary.
  title                 String
  /// Full detail of the issue the user is experiencing.
  description           String                @db.Text
  priority              SupportTicketPriority @default(MEDIUM)
  status                SupportTicketStatus   @default(OPEN)
  /// Snapshot of the reporter's email at creation (survives staff deletion).
  reporterEmail         String
  createdByStaffUserId  String?
  /// Developer's proposed fix, recorded before approval.
  proposedFix           String?               @db.Text
  /// Free-text resolution note when closed.
  resolutionNote        String?               @db.Text
  /// Approval is restricted to the configured approver (greg@bidlow.co.uk).
  approvedByStaffUserId String?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  createdBy   StaffUser?                @relation("SupportTicketCreatedBy", fields: [createdByStaffUserId], references: [id], onDelete: SetNull)
  approvedBy  StaffUser?                @relation("SupportTicketApprovedBy", fields: [approvedByStaffUserId], references: [id], onDelete: SetNull)
  attachments SupportTicketAttachment[]

  @@index([status, createdAt])
  @@index([createdByStaffUserId])
}

model SupportTicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  fileName  String
  mimeType  String
  sizeBytes Int
  /// Raw image bytes (screenshot). Stored in DB like ClientComplianceAttachment.
  data      Bytes
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// ——— Tenant / workspace ———

model Client {
  id                            String                    @id @default(cuid())
  name                          String
  slug                          String                    @unique
  status                        ClientLifecycleStatus     @default(ONBOARDING)
  industry                      String?
  website                       String?
  notes                         String?
  /// Optional per-client logo URL — rendered in the client workspace header, overview, and brief.
  logoUrl                       String?
  /// Optional accessible alt text for `logoUrl`. When null, UI falls back to the client name.
  logoAltText                   String?
  /// Opaque token for inbound webhook URL — maps to this tenant only
  inboundIngestToken            String                    @unique @default(cuid())
  /// Default From: for outbound (operational placeholder until per-mailbox config)
  defaultSenderEmail            String?
  /// Provider/domain verification is tracked outside this app until integrated — gates real sends when enforced
  senderIdentityStatus          SenderIdentityStatus      @default(NOT_SET)
  /// PR K — Recorded launch approval trail (null for legacy ACTIVE clients predating the workflow).
  launchApprovedAt              DateTime?
  launchApprovedByStaffUserId   String?
  launchApprovalMode            ClientLaunchApprovalMode?
  launchApprovalNotes           String?                   @db.Text
  /// Snapshot of the readiness checklist recorded at approval time — never rewritten after approval.
  launchApprovalChecklist       Json?
  /// Per-client business brief — structured v2. JSON keys: line1, line2, city, region, postalCode, country, formattedSummary
  briefBusinessAddress          Json?
  /// Main point of contact: firstName, lastName, role, email, mobile, status (string enum: active|inactive|unknown)
  briefMainContact              Json?
  /// Company LinkedIn page URL
  briefLinkedinUrl              String?
  /// Company landline shown in outreach mailbox signatures — the default the
  /// one-click branded signature uses for every mailbox. A mailbox's own
  /// `senderPhone` overrides it when set.
  signaturePhone                String?
  /// How many outreach emails leave a mailbox together, with a natural gap
  /// before the next group — the "4 at a time" the client was promised. Null
  /// means use the house default (see DEFAULT_SEND_BATCH_SIZE). Clamped to
  /// 1..MAX_SEND_BATCH_SIZE on read; it can only re-shape a daily cap, never
  /// raise one.
  sendBatchSize                 Int?
  /// Commercial handling tier — CORPORATE (VIP) / MID / STANDARD. Drives the
  /// four-at-a-time release gate on the send screen (corporate only). Null =
  /// nobody has graded this account yet, which is handled as STANDARD: the
  /// grade can only ever slow sending down, so defaulting an ungraded client
  /// into the slow path would silently change live behaviour for every
  /// existing client.
  accountGrade                  ClientAccountGrade?
  /// Who last set `accountGrade`, shown ON SCREEN next to the control. A change
  /// that decides how a client's outreach is released must have a name against
  /// it; the full history is appended to AuditLog as well.
  accountGradeSetByStaffUserId  String?
  accountGradeSetAt             DateTime?
  /// Machine sending or human sending, for THIS client. Consulted by
  /// `@/lib/safety/autonomous-actor-guard` at the moment of dispatch.
  /// true  = a machine may send for this client on its own.
  /// false = only a signed-in member of staff may send for them.
  /// null  = NOBODY HAS DECIDED YET, which refuses. Three states on purpose:
  /// a plain boolean cannot tell "we decided not to" from "nobody has looked at
  /// this client", and absence is not permission.
  autonomousSendEnabled         Boolean?
  /// Who last set `autonomousSendEnabled`, shown ON SCREEN next to the switch.
  /// A decision that lets a machine cold-email a stranger from this client's own
  /// domain must have a name against it; the full history goes to AuditLog too.
  autonomousSendSetByStaffUserId String?
  autonomousSendSetAt           DateTime?
  /// Operator-only context — not shown in outreach templates
  briefInternalNotes            String?                   @db.Text
  briefAssignedAccountManagerId String?
  /// Sender-aligned outreach link domain (go.<customer-domain>) that serves this
  /// client's unsubscribe + open-tracking links. Aligning links with the sending
  /// domain avoids the cross-domain (phishing) signal that gets outreach
  /// quarantined. Set only once the DNS CNAME + app custom-domain routing are live.
  outreachLinkDomain            String?
  /// When `outreachLinkDomain` was verified as serving correctly. Null = unverified;
  /// real-prospect sends are blocked when the hard rule is enforced
  /// (OUTREACH_REQUIRE_ALIGNED_LINK_DOMAIN).
  outreachLinkDomainVerifiedAt  DateTime?
  /// Per-client open-tracking opt-in. NULL = OFF, and null is the default for
  /// every client forever — tracking is never on because nobody turned it off.
  /// Only set once the customer has agreed to the DNS change and their
  /// `outreachLinkDomain` is verified, so a tracked email can only ever carry a
  /// same-domain pixel. `OPEN_TRACKING_PIXEL=off` remains a global backstop.
  openTrackingEnabledAt         DateTime?
  /// Who switched open tracking on for this client (audit trail; null when off).
  openTrackingEnabledByStaffUserId String?
  /// When this system last RESOLVED this client's SPF, DKIM, DMARC and tracking
  /// host and found ALL FOUR correct. Null = never passed, which means tracking
  /// is off. Written only by the verifier — never by a form, and never by a
  /// person asserting the records are in place. A timestamp rather than a
  /// boolean because DNS is a lease, not a fact: `decideClientOpenTracking`
  /// treats a value older than TRACKING_DNS_MAX_AGE_DAYS as expired, so tracking
  /// closes itself even if the scheduled re-check stops running.
  trackingDnsVerifiedAt         DateTime?
  /// When the verifier last LOOKED, pass or fail. Distinct from the field above
  /// so the screen can tell "checked an hour ago and it failed" apart from
  /// "nothing has checked this since Tuesday" — those need different actions.
  trackingDnsCheckedAt          DateTime?
  /// The four check results from the most recent run, as
  /// `{ label, pass, detail }[]`. Stored so staff can see exactly what the
  /// system found — the record it actually read, and what it wanted instead —
  /// without anyone running dig by hand.
  trackingDnsReport             Json?
  createdAt                     DateTime                  @default(now())
  updatedAt                     DateTime                  @updatedAt
  /// F2 — soft-delete marker. Non-null = workspace deleted: hidden everywhere
  /// and recoverable within the window before a separate, explicit hard purge.
  deletedAt                     DateTime?
  deletedByStaffUserId          String?

  memberships                     ClientMembership[]
  onboarding                      ClientOnboarding?
  contacts                        Contact[]
  contactLists                    ContactList[]
  contactListMembers              ContactListMember[]
  importBatches                   ContactImportBatch[]
  rocketReachJobs                 RocketReachEnrichment[]
  suppressionSources              SuppressionSource[]
  suppressedEmails                SuppressedEmail[]
  suppressedDomains               SuppressedDomain[]
  suppressedDomainFamilies        SuppressedDomainFamily[]
  suppressedDomainFamilyProposals SuppressedDomainFamilyProposal[]
  campaigns                       Campaign[]
  outboundEmails                  OutboundEmail[]
  inboundReplies                  InboundReply[]
  reportingSnapshots              ReportingDailySnapshot[]
  auditLogs                       AuditLog[]
  outboundProviderEvents          OutboundProviderEvent[]
  mailboxIdentities               ClientMailboxIdentity[]
  /// Microsoft Graph–ingested inbox rows (idempotent by mailbox + Graph message id)
  inboundMailboxMessages          InboundMailboxMessage[]
  /// Advisory "someone is looking at this reply" markers. Ephemeral by design.
  replyClaims                     ReplyClaim[]
  mailboxSendReservations         MailboxSendReservation[]
  emailTemplates                  ClientEmailTemplate[]
  emailSequences                  ClientEmailSequence[]
  sequenceEnrollments             ClientEmailSequenceEnrollment[]
  sequenceStepSends               ClientEmailSequenceStepSend[]
  unsubscribeTokens               UnsubscribeToken[]
  launchApprovedBy                StaffUser?                       @relation("ClientLaunchApprovedBy", fields: [launchApprovedByStaffUserId], references: [id], onDelete: SetNull)
  accountGradeSetBy               StaffUser?                       @relation("ClientAccountGradeSetBy", fields: [accountGradeSetByStaffUserId], references: [id], onDelete: SetNull)
  autonomousSendSetBy             StaffUser?                       @relation("ClientAutonomousSendSetBy", fields: [autonomousSendSetByStaffUserId], references: [id], onDelete: SetNull)
  briefAccountManager             StaffUser?                       @relation("ClientBriefAccountManager", fields: [briefAssignedAccountManagerId], references: [id], onDelete: SetNull)
  briefTaxonomyLinks              ClientBriefTermLink[]
  complianceAttachments           ClientComplianceAttachment[]
  briefTaxonomyFirstUses          BriefTaxonomyTerm[]              @relation("BriefTermFirstClient")
  universesFirstSeen              ContactUniverse[]                @relation("UniverseFirstSeenClient")
  contactUniverseSources          ContactUniverseSource[]

  @@index([deletedAt])
  @@index([status])
  @@index([launchApprovedByStaffUserId])
  @@index([briefAssignedAccountManagerId])
  @@index([accountGradeSetByStaffUserId])
  @@index([autonomousSendSetByStaffUserId])
}

/// Reusable brief vocabulary: service areas, ICP industries, company sizes, target titles
enum BriefTaxonomyKind {
  SERVICE_AREA
  TARGET_INDUSTRY
  COMPANY_SIZE
  JOB_TITLE
}

model BriefTaxonomyTerm {
  id                  String            @id @default(cuid())
  kind                BriefTaxonomyKind
  /// Lowercase, trimmed, single-spaced — dedupe key
  normalizedValue     String
  /// Original casing for display
  displayValue        String
  /// Client workspace that first created this value (for audit)
  firstUsedByClientId String?
  createdAt           DateTime          @default(now())

  firstUsedByClient Client?               @relation("BriefTermFirstClient", fields: [firstUsedByClientId], references: [id], onDelete: SetNull)
  clientLinks       ClientBriefTermLink[]

  @@unique([kind, normalizedValue])
  @@index([kind])
  @@index([firstUsedByClientId])
}

model ClientBriefTermLink {
  clientId String
  termId   String
  client   Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  term     BriefTaxonomyTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([clientId, termId])
  @@index([clientId])
  @@index([termId])
}

model ClientComplianceAttachment {
  id                    String   @id @default(cuid())
  clientId              String
  fileName              String
  mimeType              String
  sizeBytes             Int
  /// PDF bytes only — size-capped in application code
  data                  Bytes
  createdAt             DateTime @default(now())
  uploadedByStaffUserId String?

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedBy StaffUser? @relation("ClientComplianceUpload", fields: [uploadedByStaffUserId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([uploadedByStaffUserId])
}

/// Connected outreach sending/receiving identity for a client workspace (max 5 active per client).
model ClientMailboxIdentity {
  id                       String                  @id @default(cuid())
  clientId                 String
  provider                 MailboxProvider
  /// Normalized lowercase email — single source of truth for display and uniqueness
  email                    String
  emailNormalized          String
  displayName              String?
  connectionStatus         MailboxConnectionStatus @default(DRAFT)
  isActive                 Boolean                 @default(true)
  isPrimary                Boolean                 @default(false)
  /// Provider capability — future send/reply integration
  canSend                  Boolean                 @default(true)
  canReceive               Boolean                 @default(true)
  /// OpensDoors hard rule: default 30 sends per mailbox per rolling/window day (enforced in later slices)
  dailySendCap             Int                     @default(30)
  /// Operator toggle to pause sending without deleting the row
  isSendingEnabled         Boolean                 @default(true)
  /// Counters reset when `now` passes `dailyWindowResetAt` (worker/sync responsibility in later slices)
  emailsSentToday          Int                     @default(0)
  dailyWindowResetAt       DateTime?
  lastSyncAt               DateTime?
  lastError                String?                 @db.Text
  /// Per-mailbox sender identity. Populated from Gmail `users.settings.sendAs` when
  /// available; otherwise set manually in Mailboxes. Optional client-level text in
  /// the historical brief may still be used as a last-resort composition fallback
  /// for `{{email_signature}}` for legacy data — operators configure signatures here.
  senderDisplayName        String?
  /// Optional per-mailbox phone for this sender's signature. Overrides the
  /// client-level `Client.signaturePhone` when set; blank falls back to it.
  senderPhone              String?
  /// Raw HTML signature as retrieved from Gmail `sendAs.signature` or pasted
  /// manually. Never rendered without going through the signature helper.
  senderSignatureHtml      String?                 @db.Text
  /// Plain-text rendering used by the current text-body send path.
  senderSignatureText      String?                 @db.Text
  /// `gmail_send_as` | `manual` | `unsupported_provider` | null (missing).
  senderSignatureSource    String?
  senderSignatureSyncedAt  DateTime?
  senderSignatureSyncError String?                 @db.Text
  /// Opaque CSRF value for in-flight OAuth (Microsoft / Google mailbox connection)
  oauthState               String?                 @unique
  oauthStateExpiresAt      DateTime?
  /// Provider account id after connect (e.g. Google `sub`, Microsoft Graph `id`) — not a secret
  providerLinkedUserId     String?
  connectedAt              DateTime?
  createdByStaffUserId     String?
  /// Set when the mailbox address is taken out of the active workspace pool. Row + history preserved.
  workspaceRemovedAt       DateTime?
  workspaceRemovedById     String?
  /// Optional short operator context (e.g. reason code); not a secret.
  workspaceRemovedNote     String?                 @db.VarChar(2000)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  client                       Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy                    StaffUser?               @relation("MailboxIdentityCreatedBy", fields: [createdByStaffUserId], references: [id], onDelete: SetNull)
  workspaceRemovedBy           StaffUser?               @relation("MailboxIdentityWorkspaceRemovedBy", fields: [workspaceRemovedById], references: [id], onDelete: SetNull)
  secret                       MailboxIdentitySecret?
  graphIngestedMessages        InboundMailboxMessage[]
  sendReservations             MailboxSendReservation[]
  outboundSends                OutboundEmail[]
  preferredForSequenceLaunches ClientEmailSequence[]    @relation("SequenceLaunchMailbox")

  @@unique([clientId, emailNormalized])
  @@index([clientId, isActive])
  @@index([clientId, workspaceRemovedAt])
  @@index([createdByStaffUserId])
  @@index([workspaceRemovedById])
}

/// Server-side OAuth token material for a mailbox identity (never exposed to the client UI).
model MailboxIdentitySecret {
  id                  String          @id @default(cuid())
  mailboxIdentityId   String          @unique
  provider            MailboxProvider
  /// AES-GCM payload (base64) — JSON with refresh_token, access_token, expires_at, scope, etc.
  encryptedCredential String          @db.Text
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  mailbox ClientMailboxIdentity @relation(fields: [mailboxIdentityId], references: [id], onDelete: Cascade)
}

/// Inbox rows ingested from Microsoft Graph (delegated Mail.Read) — not ESP webhooks.
model InboundMailboxMessage {
  id                     String    @id @default(cuid())
  clientId               String
  mailboxIdentityId      String
  /// Microsoft Graph message id (id property)
  providerMessageId      String
  fromEmail              String
  toEmail                String?
  subject                String?   @db.Text
  /// Short preview; avoid storing full body in this slice
  snippet                String?   @db.Text
  bodyPreview            String?   @db.Text
  receivedAt             DateTime
  /// Graph conversationId (threading)
  conversationId         String?
  /// e.g. MICROSOFT_GRAPH — extensible
  ingestionSource        String    @default("MICROSOFT_GRAPH")
  /// Opaque: internetMessageId, odata, etc. (no raw MIME)
  metadata               Json?
  /// PR P — full inbound body, safely normalized.
  /// Always prefer rendering `bodyText` (plain text extracted from the
  /// provider payload). Set by ingestion (Microsoft) or the on-demand
  /// fetch action (Gmail / backfill). `NULL` when only a preview exists.
  bodyText               String?   @db.Text
  /// Raw provider content type for `bodyText`: "text", "html", or
  /// "multipart". Used for operator debug, not for render decisions.
  bodyContentType        String?
  /// Byte length of the raw provider body we normalized (before
  /// extraction). Lets us surface "Fetched X KB" without re-fetching.
  fullBodySize           Int?
  /// "MICROSOFT_GRAPH" | "GMAIL_API" — where we pulled the body from.
  fullBodySource         String?
  /// Timestamp of the last successful full-body fetch. `NULL` means we
  /// still only have a snippet/preview for this message.
  fullBodyFetchedAt      DateTime?
  /// Storage version bump if we change normalization rules so
  /// re-fetching can be forced. Starts at 1.
  fullBodyStorageVersion Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt

  client  Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mailbox ClientMailboxIdentity @relation(fields: [mailboxIdentityId], references: [id], onDelete: Cascade)

  @@unique([mailboxIdentityId, providerMessageId])
  @@index([clientId, receivedAt])
  @@index([mailboxIdentityId, receivedAt])
}

/// Which conversation a `ReplyClaim` is attached to. A prospect's reply is
/// reachable by two routes — the inbound message detail page and the
/// linked-reply page — and both resolve to INBOUND_MESSAGE whenever the
/// mailbox sync correlated them, so one claim is visible from either route.
/// Webhook-ingested replies have no correlated mailbox message and use
/// INBOUND_REPLY with their own id.
enum ReplyClaimSubjectType {
  INBOUND_MESSAGE
  INBOUND_REPLY
}

/// ADVISORY "someone is looking at this reply" marker — NOT a lock. Nothing
/// in the codebase reads this to decide whether an action may proceed; it
/// only decides what the second operator is TOLD before they act.
///
/// Deliberately its own table rather than a key on
/// `InboundMailboxMessage.metadata`, where the neighbouring handling state
/// lives. The reply sync's upsert writes `metadata` wholesale on every run
/// (`mailbox-inbox-sync.ts`), so anything stored there is erased for recent
/// messages every 15 minutes — a claim written into that column would stop
/// being shown minutes after it was made, while still looking wired up.
///
/// Rows are ephemeral: written when a reply detail page is opened, deleted
/// the moment anyone acts on the conversation, and ignored once older than
/// `REPLY_CLAIM_STALE_AFTER_MS` (30 minutes). Nothing downstream depends on
/// them, so a stale row is inert rather than wrong, and no sweeper job is
/// required for correctness.
model ReplyClaim {
  id          String                @id @default(cuid())
  clientId    String
  subjectType ReplyClaimSubjectType
  subjectId   String
  staffUserId String
  /// Refreshed each time this operator re-opens the reply.
  claimedAt   DateTime              @default(now())

  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  staffUser StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)

  /// One claim per operator per conversation — re-opening refreshes rather
  /// than accumulating rows.
  @@unique([clientId, subjectType, subjectId, staffUserId])
  @@index([clientId, subjectType, subjectId, claimedAt])
  @@index([staffUserId])
}

model ClientMembership {
  id          String           @id @default(cuid())
  staffUserId String
  clientId    String
  role        ClientMemberRole @default(CONTRIBUTOR)
  createdAt   DateTime         @default(now())
  staffUser   StaffUser        @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([staffUserId, clientId])
  @@index([clientId])
}

model ClientOnboarding {
  id             String    @id @default(cuid())
  clientId       String    @unique
  currentStep    Int       @default(1)
  completedSteps Json      @default("[]")
  /// JSON blob: basics, suppression sheet refs, outreach prefs — flexible for the wizard
  formData       Json      @default("{}")
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

// ——— Contacts & imports ———

model ContactImportBatch {
  id              String                  @id @default(cuid())
  clientId        String
  fileName        String?
  rowCount        Int                     @default(0)
  status          ImportBatchStatus       @default(PENDING)
  errorMessage    String?
  /// Import outcome: created, skipped, duplicates, sample errors — JSON
  summary         Json?
  completedAt     DateTime?
  createdAt       DateTime                @default(now())
  client          Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contacts        Contact[]
  universeSources ContactUniverseSource[]

  @@index([clientId, createdAt])
}

model Contact {
  id                     String        @id @default(cuid())
  clientId               String
  /// Email is nullable as of PR F1. Contacts can be persisted and kept in
  /// lists for enrichment/cold-outreach pipelines even when no email is
  /// known. The Postgres `@@unique([clientId, email])` constraint still
  /// prevents duplicate emails per client; NULLs are treated as distinct
  /// by the default unique-index semantics, so multiple no-email contacts
  /// can coexist in the same client workspace. Every send / suppression /
  /// enrollment path treats null email as "valid but not email-sendable"
  /// — see `src/lib/client-contacts-readiness.ts` and PR F2 hardening.
  email                  String?
  /// Optional full name from CSV / enrichment
  fullName               String?
  /// Normalized domain part of email (lowercase), for display and guards
  emailDomain            String?
  firstName              String?
  lastName               String?
  company                String?
  title                  String?
  /// First-class outreach identifiers from the CSV/RocketReach import contract
  /// (docs/ops/CLIENT_WORKSPACE_MODULE_AUDIT.md §0.1). A contact is valid when
  /// it is not suppressed AND has at least one of email / linkedIn /
  /// mobilePhone / officePhone.
  linkedIn               String?
  mobilePhone            String?
  officePhone            String?
  location               String?
  city                   String?
  country                String?
  industry               String?
  source                 ContactSource @default(MANUAL)
  importBatchId          String?
  /// Cached flag after suppression check (refresh on sync)
  isSuppressed           Boolean       @default(false)
  lastSuppressionCheckAt DateTime?
  universeContactId      String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  client              Client                          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  importBatch         ContactImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  universeContact     ContactUniverse?                @relation(fields: [universeContactId], references: [id], onDelete: SetNull)
  rocketReach         RocketReachEnrichment?
  outboundEmails      OutboundEmail[]
  inboundReplies      InboundReply[]
  listMemberships     ContactListMember[]
  sequenceEnrollments ClientEmailSequenceEnrollment[]
  sequenceStepSends   ClientEmailSequenceStepSend[]
  unsubscribeTokens   UnsubscribeToken[]

  @@unique([clientId, email])
  @@index([clientId])
  @@index([importBatchId])
  @@index([universeContactId])
}

/// OpensDoors global contact warehouse — deduplicated across imports and clients.
model ContactUniverse {
  id                    String             @id @default(cuid())
  /// Lowercase trimmed email; unique when present (Postgres allows many NULLs).
  emailNormalized       String?            @unique
  linkedinUrlNormalized String?
  mobilePhoneNormalized String?
  officePhoneNormalized String?
  firstName             String?
  lastName              String?
  fullName              String?
  jobTitle              String?
  companyName           String?
  location              String?
  city                  String?
  country               String?
  industry              String?
  /// Human-readable rollup for the Sources / Universe table (not raw JSON).
  sourceSummary         String?
  firstSeenClientId     String?
  firstSeenSourceType   UniverseSourceType @default(OTHER)
  firstSeenAt           DateTime           @default(now())
  lastSeenAt            DateTime           @default(now())
  /// Optional weak dedupe key (company + name + title hash) when no strong identifiers.
  weakMatchKey          String?            @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  firstSeenClient Client?                 @relation("UniverseFirstSeenClient", fields: [firstSeenClientId], references: [id], onDelete: SetNull)
  sources         ContactUniverseSource[]
  clientContacts  Contact[]

  @@index([linkedinUrlNormalized])
  @@index([mobilePhoneNormalized])
  @@index([lastSeenAt])
  @@index([firstSeenClientId])
  @@index([companyName])
  @@index([country])
}

model ContactUniverseSource {
  id                  String             @id @default(cuid())
  universeContactId   String
  clientId            String?
  sourceType          UniverseSourceType
  /// Import file name, list name, or operator label.
  sourceLabel         String?
  importBatchId       String?
  rocketReachPersonId String?
  rawSourceMetadata   Json?
  createdAt           DateTime           @default(now())

  universe    ContactUniverse     @relation(fields: [universeContactId], references: [id], onDelete: Cascade)
  client      Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  importBatch ContactImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([universeContactId])
  @@index([clientId])
  @@index([importBatchId])
  @@index([sourceType])
}

/// Named reusable list of contacts (universal-contact bridge, PR D1).
/// Per docs/ops/UNIVERSAL_CONTACTS_AND_LISTS_PLAN.md §0.1 (Option A):
/// a list is either global (`clientId = null`) or belongs to exactly one
/// client. Many-to-many list↔client is deferred until a later PR.
/// Dedupe is by `Contact.email` today; LinkedIn/phone dedupe is deferred
/// per §0.5. Nothing in this PR (D1) reads or writes these rows yet —
/// the UI and import paths start using them in PR D2.
model ContactList {
  id                   String    @id @default(cuid())
  name                 String
  description          String?
  clientId             String?
  createdByStaffUserId String?
  /// When set, list is hidden from operators but kept for sequence/history FK integrity.
  archivedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  client              Client?                         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy           StaffUser?                      @relation("ContactListCreatedBy", fields: [createdByStaffUserId], references: [id], onDelete: SetNull)
  members             ContactListMember[]
  sequences           ClientEmailSequence[]
  sequenceEnrollments ClientEmailSequenceEnrollment[]
  sequenceStepSends   ClientEmailSequenceStepSend[]

  @@index([clientId])
  @@index([name])
  @@index([createdByStaffUserId])
  @@index([clientId, archivedAt])
}

/// Join table for ContactList ↔ Contact (PR D1). Idempotent per pair via
/// `@@unique([contactListId, contactId])`. Contact ownership still lives
/// on `Contact.clientId` until PR D5 backfill.
///
/// Tenant-isolation (critical): `clientId` is denormalized from the row's
/// `Contact.clientId` and enforced by a DB trigger
/// (`ContactListMember_client_scope_guard`) so that:
///   * `clientId` must equal `Contact.clientId` for `contactId`.
///   * If the target `ContactList.clientId` is non-null, it must match
///     `clientId` — a client-scoped list can only contain same-client
///     contacts.
///   * A global list (`ContactList.clientId IS NULL`) can hold contacts
///     from any client, but each row still pins the contact's client
///     scope via `clientId`.
/// See migration 20260420200000_contact_lists_additive for the trigger.
model ContactListMember {
  id                 String   @id @default(cuid())
  contactListId      String
  contactId          String
  clientId           String
  addedByStaffUserId String?
  addedAt            DateTime @default(now())

  contactList ContactList @relation(fields: [contactListId], references: [id], onDelete: Cascade)
  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  addedBy     StaffUser?  @relation("ContactListMemberAddedBy", fields: [addedByStaffUserId], references: [id], onDelete: SetNull)

  @@unique([contactListId, contactId])
  @@index([contactId])
  @@index([clientId])
  @@index([addedByStaffUserId])
}

model RocketReachEnrichment {
  id         String               @id @default(cuid())
  clientId   String
  contactId  String?              @unique
  externalId String?
  status     RocketReachJobStatus @default(PENDING)
  rawPayload Json?
  lastError  String?
  fetchedAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([externalId])
}

// ——— Suppression (Google Sheets source of truth per tenant) ———

model SuppressionSource {
  id                  String                @id @default(cuid())
  clientId            String
  kind                SuppressionListKind
  /// Google Spreadsheet ID
  spreadsheetId       String?
  /// Sheet name or gid reference
  sheetRange          String?
  label               String?
  syncStatus          SuppressionSyncStatus @default(NOT_CONFIGURED)
  lastSyncedAt        DateTime?
  lastError           String?
  /// Opaque ref to stored OAuth / service account (never raw tokens in DB)
  googleConnectionRef String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  suppressedEmails  SuppressedEmail[]
  suppressedDomains SuppressedDomain[]

  @@index([clientId, kind])
}

model SuppressedEmail {
  id       String             @id @default(cuid())
  clientId String
  email    String
  sourceId String?
  syncedAt DateTime           @default(now())
  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source   SuppressionSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([clientId, email])
  @@index([clientId])
}

/// RULING 3 (Greg, 2026-08-24) — a suppressed domain may also cover RELATED
/// COMPANY domains, but only ones a human has explicitly listed for that client.
///
/// It cannot be inferred and must not be: `bteurope.com` shares no text with
/// `bt.com`, and any algorithm that connected them would also connect things
/// that are not related — over-blocking a client's real prospects is its own
/// failure. So someone types "BT" and lists the domains that belong to it.
///
/// A family is simply the set of rows sharing a `label` within one client.
/// Suppression is transitive across the family: if ANY member domain is
/// suppressed for this client, EVERY member is treated as suppressed.
///
/// Per client by construction — one client's view of who BT is has nothing to
/// do with another's. Default empty, so nothing changes for any existing client
/// until a human fills it in.
/// How a family link was discovered. Both are records the company itself
/// published about its own domains.
///
/// Certificate Transparency is deliberately absent and must not be added without
/// new evidence: measured 2026-08-24, one GlobalSign OV certificate merged a
/// client with eight unrelated train operators, and all three proposed guards
/// passed it.
enum FamilyProposalSource {
  /// The domain's DMARC record sends aggregate reports to the other domain.
  DMARC_RUA
  /// The domain's SPF record redirects to the other domain. RFC 7208 s6.1
  /// designates `redirect=` for the same administrative domain; `include:` is
  /// s5.2's mechanism for CROSSING one, and is deliberately not used here.
  SPF_REDIRECT
  /// The two domains are verified domains of the SAME Microsoft 365 tenant.
  ///
  /// The strongest of the three, and the only one that may block on its own:
  /// a domain enters a tenant only after somebody with control of it proved
  /// that control to Microsoft and a directory administrator admitted it, so
  /// this is common ownership asserted by the organisation, not inferred here.
  /// Measured 2026-08-27 — it links halifax.co.uk to bankofscotland.co.uk and
  /// centrica.com to britishgas.co.uk, none of which DMARC or SPF can see.
  MICROSOFT_TENANT
}

enum FamilyProposalStatus {
  PENDING
  CONFIRMED
  /// Final. Re-resolution may never move a row out of this state.
  REJECTED
}

model SuppressedDomainFamily {
  id                   String   @id @default(cuid())
  clientId             String
  /// Human label for the company, e.g. "BT". Free text, normalised for display
  /// only — the label groups rows, it is never matched against an email.
  label                String
  /// Normalised domain (lowercase, no protocol/path/www), e.g. "bteurope.com".
  domain               String
  /// Who added it, for the audit trail. Null for system/seed rows.
  createdByStaffUserId String?
  createdAt            DateTime @default(now())

  /// PROVENANCE. Null on every row that predates automatic discovery, which is
  /// every row today - null therefore means "a human typed this".
  ///
  /// Without these three columns a machine proposal, a seed row and a
  /// hand-entered fact are the same row, and an operator cannot tell which to
  /// distrust. RULING 3 still holds: nothing reaches this table without a human
  /// clicking confirm. These record WHICH proposal that click accepted.
  sourceProposalId String?               @unique
  discoveredSource FamilyProposalSource?
  discoveredAt     DateTime?

  client         Client                          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy      StaffUser?                      @relation("SuppressedDomainFamilyCreatedBy", fields: [createdByStaffUserId], references: [id], onDelete: SetNull)
  sourceProposal SuppressedDomainFamilyProposal? @relation("ConfirmedFromProposal", fields: [sourceProposalId], references: [id], onDelete: SetNull)

  /// A domain belongs to at most one family per client — otherwise "which
  /// family is bteurope.com in" has no answer and the gate is ambiguous.
  @@unique([clientId, domain])
  @@index([clientId, label])
}

/// Where the machine's guesses live, and the reason they are safe.
///
/// RULING 3 (Greg, 2026-08-24) says family membership is a listed fact and must
/// never be inferred. That still holds. Nothing in this table is read by the
/// send gate - `evaluateSuppression` never touches it. A row here is a QUESTION
/// put to an operator, and only their confirmation writes a
/// `SuppressedDomainFamily` row.
///
/// The measurement that produced this design (2026-08-24, recorded in STATE.md):
/// writing discovered links straight into `SuppressedDomainFamily` would have
/// been unsafe whatever the source, because blocking there is transitive across
/// a label and a deleted row is re-created by the next resolution run.
model SuppressedDomainFamilyProposal {
  id       String @id @default(cuid())
  clientId String

  /// The suppressed domain the link was found FROM - the one already on the
  /// client's do-not-contact list.
  seedDomain     String
  /// The domain we believe belongs with it. Normalised, lowercase, no www.
  proposedDomain String

  source   FamilyProposalSource
  /// The record text exactly as read, so an operator (or a later reviewer) can
  /// see the evidence rather than trust the verdict.
  evidence String               @db.Text

  /// How many OTHER contact domains also point at `proposedDomain`.
  ///
  /// Measured on production: every genuine corporate relative had fan-in 1-2,
  /// every shared vendor 9 or more (outlook.com 216, google.com 11,
  /// salesforce.com 9). Proposals at or above the cap are never raised. This is
  /// NOT the safety mechanism - the operator's click is - so the number is shown
  /// on screen too: "4 other companies also point here" is what makes a person
  /// say no. `nhs.net` had fan-in 2 and is still a shared service.
  fanIn Int

  discoveredAt DateTime @default(now())

  /// REJECTED IS A TOMBSTONE. Re-resolution must never move a row out of it.
  /// Without this, the 30-day re-run reads the same DNS, derives the same link,
  /// and silently reinstates something an operator deliberately refused.
  status FamilyProposalStatus @default(PENDING)

  decidedByStaffUserId String?
  decidedAt            DateTime?

  client          Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  decidedBy       StaffUser?              @relation("FamilyProposalDecidedBy", fields: [decidedByStaffUserId], references: [id], onDelete: SetNull)
  confirmedFamily SuppressedDomainFamily? @relation("ConfirmedFromProposal")

  /// One proposal per (client, seed, proposed) - re-resolution updates the
  /// existing row rather than raising the same question twice.
  @@unique([clientId, seedDomain, proposedDomain])
  @@index([clientId, status])
}

model SuppressedDomain {
  id       String             @id @default(cuid())
  clientId String
  domain   String
  sourceId String?
  syncedAt DateTime           @default(now())
  client   Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  source   SuppressionSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@unique([clientId, domain])
  @@index([clientId])
}

/// Feature A (prod hardening) — global internal seed / allowlist.
///
/// An admin-managed list of OpensDoors-internal test addresses that are ALWAYS
/// deliverable: they are exempt from the send-time suppression gate
/// (`evaluateSuppression`) and NO automated process (import, suppression
/// refresh, hard-bounce, or spam-complaint) may ever add them to suppression.
/// Global (not tenant-scoped) — a seed address is exempt for every client.
///
/// Entirely INERT unless the `INTERNAL_SEED_ALLOWLIST_ENABLED` feature flag is
/// on: with the flag off, no read path consults this table and the live send
/// path behaves exactly as before. Reputation-sensitive analytics exclude
/// these addresses so internal test sends never skew real campaign metrics.
model InternalSeedAddress {
  id                   String   @id @default(cuid())
  /// Lowercase, trimmed email (same normalization as the suppression keys).
  email                String   @unique
  /// Human label shown in the admin UI, e.g. "Adam (internal test)".
  label                String?
  /// Free-text note (why this address is on the allowlist).
  note                 String?
  /// Soft on/off without deleting history; only active rows are exempt.
  isActive             Boolean  @default(true)
  /// Audit pointer to the staff user who added it (no FK to keep this additive).
  createdByStaffUserId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([isActive])
}

/// PR M — One-click unsubscribe token.
///
/// Opaque per-recipient-per-send token created when a sequence email is
/// dispatched. The raw token is embedded in the outbound email (body
/// link + List-Unsubscribe header); only the SHA-256 hash is stored in
/// the database so a leaked database dump cannot be used to forge
/// unsubscribe links for other recipients.
///
/// `purpose` stays `"outreach_unsubscribe"` today; future compliance
/// flows (e.g. Customer Account identity confirmation) can reuse the
/// same table with a different purpose without schema changes.
model UnsubscribeToken {
  id              String    @id @default(cuid())
  /// SHA-256 (hex) of the raw token. Unique so each raw token resolves
  /// to exactly one row.
  tokenHash       String    @unique
  clientId        String
  contactId       String?
  outboundEmailId String?
  /// Normalized lowercase recipient email the token was issued for.
  /// Authoritative for the resulting `SuppressedEmail` row.
  email           String
  /// Normalized recipient domain captured at issue time for audit only.
  emailDomain     String?
  /// Reason the token was issued. Default `"outreach_unsubscribe"` —
  /// other compliance purposes may reuse this table in future PRs.
  purpose         String    @default("outreach_unsubscribe")
  /// When the token was redeemed. Null = never used.
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  client        Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  outboundEmail OutboundEmail? @relation(fields: [outboundEmailId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([email])
  @@index([contactId])
  @@index([outboundEmailId])
}

// ——— Outreach (not CRM) ———

model Campaign {
  id          String         @id @default(cuid())
  clientId    String
  name        String
  status      CampaignStatus @default(DRAFT)
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  outboundEmails OutboundEmail[]

  @@index([clientId, status])
}

/// Per-client email template library (PR D4a — foundation only).
///
/// OpensDoors staff author messages per client, mark them ready for
/// review, then approve them. Only APPROVED templates will be eligible
/// for future sequences (PR D4b+). Sending is NOT implemented here:
/// this model has no send-time fields and is not referenced by any
/// outbound worker.
///
/// Placeholders are validated in application code
/// (`src/lib/email-templates/placeholders.ts`); unknown placeholders
/// block approval but are allowed in DRAFT / READY_FOR_REVIEW so
/// operators can iterate.
model ClientEmailTemplate {
  id                    String                      @id @default(cuid())
  clientId              String
  name                  String
  category              ClientEmailTemplateCategory
  subject               String                      @db.Text
  content               String                      @db.Text
  status                ClientEmailTemplateStatus   @default(DRAFT)
  createdByStaffUserId  String?
  approvedByStaffUserId String?
  approvedAt            DateTime?
  archivedAt            DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  client            Client                        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy         StaffUser?                    @relation("ClientEmailTemplateCreatedBy", fields: [createdByStaffUserId], references: [id], onDelete: SetNull)
  approvedBy        StaffUser?                    @relation("ClientEmailTemplateApprovedBy", fields: [approvedByStaffUserId], references: [id], onDelete: SetNull)
  sequenceSteps     ClientEmailSequenceStep[]
  sequenceStepSends ClientEmailSequenceStepSend[]

  @@index([clientId])
  @@index([clientId, status])
  @@index([clientId, category])
  @@index([createdByStaffUserId])
  @@index([approvedByStaffUserId])
}

/// Per-client email sequence (PR D4b — records-only foundation).
///
/// A sequence pairs one client-scoped `ContactList` with an ordered set
/// of steps (`ClientEmailSequenceStep`) referencing `ClientEmailTemplate`
/// rows. The application enforces invariants; optional
/// `launchPreferredMailboxId` pins dispatch to one mailbox, otherwise
/// the eligible pool is used.
model ClientEmailSequence {
  id                       String                    @id @default(cuid())
  clientId                 String
  contactListId            String
  name                     String
  description              String?
  status                   ClientEmailSequenceStatus @default(DRAFT)
  createdByStaffUserId     String?
  approvedByStaffUserId    String?
  approvedAt               DateTime?
  archivedAt               DateTime?
  launchPreferredMailboxId String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  client                 Client                          @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactList            ContactList                     @relation(fields: [contactListId], references: [id], onDelete: Restrict)
  createdBy              StaffUser?                      @relation("ClientEmailSequenceCreatedBy", fields: [createdByStaffUserId], references: [id], onDelete: SetNull)
  approvedBy             StaffUser?                      @relation("ClientEmailSequenceApprovedBy", fields: [approvedByStaffUserId], references: [id], onDelete: SetNull)
  launchPreferredMailbox ClientMailboxIdentity?          @relation("SequenceLaunchMailbox", fields: [launchPreferredMailboxId], references: [id], onDelete: SetNull)
  steps                  ClientEmailSequenceStep[]
  enrollments            ClientEmailSequenceEnrollment[]
  stepSends              ClientEmailSequenceStepSend[]

  @@index([clientId])
  @@index([clientId, status])
  @@index([contactListId])
  @@index([createdByStaffUserId])
  @@index([approvedByStaffUserId])
  @@index([launchPreferredMailboxId])
}

/// Ordered step inside a `ClientEmailSequence` (PR D4b). Each row pins
/// a single template at a single category slot — unique per
/// `(sequenceId, position)` and per `(sequenceId, category)` so a
/// sequence can hold at most one INTRODUCTION, one FOLLOW_UP_1, etc.
/// `delayDays` + `delayHours` schedule time after the previous step (intro: after launch/enrollment).
model ClientEmailSequenceStep {
  id         String                      @id @default(cuid())
  sequenceId String
  templateId String
  category   ClientEmailTemplateCategory
  position   Int
  delayDays  Int                         @default(0)
  delayHours Int                         @default(0)
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  sequence  ClientEmailSequence           @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  template  ClientEmailTemplate           @relation(fields: [templateId], references: [id], onDelete: Restrict)
  stepSends ClientEmailSequenceStepSend[]

  @@unique([sequenceId, position])
  @@unique([sequenceId, category])
  @@index([templateId])
}

/// Per-contact enrollment in a `ClientEmailSequence` (PR D4c — records only).
///
/// An enrollment is the operator-visible record that a specific
/// contact from the sequence's target `ContactList` will walk the
/// sequence. This PR introduces records only — there is no scheduler,
/// no send worker, and no step-send trigger attached to this model.
/// Per-step sends land in PR D4e.
///
/// Invariants (enforced in application layer —
/// `src/server/email-sequences/enrollments.ts`):
///   * `enrollment.clientId === sequence.clientId` (tenant isolation)
///   * `enrollment.contactListId === sequence.contactListId`
///   * `enrollment.contactId` is a member of the sequence's list
///   * contact must be email-sendable at enrollment time unless the
///     row is explicitly marked `EXCLUDED` (not written today — the
///     enrollment writer skips ineligible contacts with counts)
///   * `(sequenceId, contactId)` is unique so re-running enrollment
///     is idempotent and cannot duplicate a recipient
model ClientEmailSequenceEnrollment {
  id                   String                              @id @default(cuid())
  clientId             String
  sequenceId           String
  contactId            String
  contactListId        String
  status               ClientEmailSequenceEnrollmentStatus @default(PENDING)
  /// Free-form operator note when status === EXCLUDED (e.g. "suppressed at enroll time").
  exclusionReason      String?
  /// 0 means not started; step-send wiring in PR D4e advances this.
  currentStepPosition  Int                                 @default(0)
  enrolledAt           DateTime                            @default(now())
  pausedAt             DateTime?
  completedAt          DateTime?
  createdByStaffUserId String?
  createdAt            DateTime                            @default(now())
  updatedAt            DateTime                            @updatedAt

  client      Client                        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sequence    ClientEmailSequence           @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  contact     Contact                       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  contactList ContactList                   @relation(fields: [contactListId], references: [id], onDelete: Restrict)
  createdBy   StaffUser?                    @relation("ClientEmailSequenceEnrollmentCreatedBy", fields: [createdByStaffUserId], references: [id], onDelete: SetNull)
  stepSends   ClientEmailSequenceStepSend[]

  @@unique([sequenceId, contactId])
  @@index([clientId])
  @@index([sequenceId, status])
  @@index([contactId])
  @@index([contactListId])
  @@index([createdByStaffUserId])
}

/// Per-enrollment, per-step send-planning record (PR D4e.1 — records only).
///
/// A row captures the intent to send a specific sequence step to a
/// specific enrolled contact. It is produced by the operator-triggered
/// planner (`src/server/email-sequences/step-sends.ts`) which:
///   * re-validates every cross-table invariant
///     (sequence↔enrollment↔step↔template↔client),
///   * renders subject + body through the pure composition helper,
///   * captures a preview snapshot for audit / UI,
///   * classifies the row as READY / SUPPRESSED / BLOCKED / SKIPPED.
///
/// RECORDS ONLY in D4e.1:
///   * No `OutboundEmail` is created from this row.
///   * `MailboxSendReservation` is NOT reserved.
///   * No ESP / Graph / Gmail API calls are issued.
///   * `SENT` and `FAILED` are reserved for D4e.2+ and are never
///     written by D4e.1 code paths.
///
/// Idempotency:
///   * `idempotencyKey` is `seq:<sequenceId>:enr:<enrollmentId>:step:<stepId>`
///     so re-running "Prepare send records" for the same step is
///     idempotent and cannot fan out duplicate rows.
///   * `@@unique([enrollmentId, stepId])` backs the same invariant at
///     the DB layer (belt + braces).
///
/// Tenant isolation is enforced at the application layer in D4e.1
/// (the planner loads every related row through `clientId`-scoped
/// reads). DB triggers are deliberately deferred to D4e.2 when the
/// worker consumes these rows.
model ClientEmailSequenceStepSend {
  id                   String                            @id @default(cuid())
  clientId             String
  sequenceId           String
  enrollmentId         String
  stepId               String
  templateId           String
  contactId            String
  contactListId        String
  status               ClientEmailSequenceStepSendStatus @default(PLANNED)
  /// Stable key built from (sequenceId, enrollmentId, stepId) — lets
  /// D4e.2 correlate a plan row to the actual dispatch attempt.
  idempotencyKey       String                            @unique
  /// Rendered preview captured at plan time (truncated). Not used for
  /// the eventual send — D4e.2 re-renders at dispatch to pick up any
  /// post-plan template edits or signature changes.
  subjectPreview       String?
  bodyPreview          String?                           @db.Text
  /// Populated when status ∈ (BLOCKED, SUPPRESSED, SKIPPED).
  blockedReason        String?
  /// Populated only when the D4e.2 dispatcher fails — never written
  /// by D4e.1 code.
  failureReason        String?
  /// Set by D4e.2+ once this plan row has been converted into an
  /// actual outbound send. `ON DELETE SET NULL` so deleting an
  /// outbound row leaves the audit plan row behind.
  outboundEmailId      String?
  plannedFor           DateTime?
  createdByStaffUserId String?
  createdAt            DateTime                          @default(now())
  updatedAt            DateTime                          @updatedAt

  client             Client                        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sequence           ClientEmailSequence           @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  enrollment         ClientEmailSequenceEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  step               ClientEmailSequenceStep       @relation(fields: [stepId], references: [id], onDelete: Restrict)
  template           ClientEmailTemplate           @relation(fields: [templateId], references: [id], onDelete: Restrict)
  contact            Contact                       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  contactList        ContactList                   @relation(fields: [contactListId], references: [id], onDelete: Restrict)
  outboundEmail      OutboundEmail?                @relation(fields: [outboundEmailId], references: [id], onDelete: SetNull)
  createdByStaffUser StaffUser?                    @relation("ClientEmailSequenceStepSendCreatedBy", fields: [createdByStaffUserId], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, stepId])
  @@index([clientId])
  @@index([sequenceId])
  @@index([enrollmentId])
  @@index([stepId])
  @@index([templateId])
  @@index([contactId])
  @@index([contactListId])
  @@index([status])
  @@index([createdByStaffUserId])
}

model OutboundEmail {
  id                     String              @id @default(cuid())
  /// Stable id for provider/webhook correlation (duplicate of id purpose; explicit for APIs)
  correlationId          String              @unique @default(cuid())
  clientId               String
  campaignId             String?
  contactId              String?
  staffUserId            String?
  /// ESP message id (SendGrid/Postmark/etc.)
  providerMessageId      String?
  /// RFC 5322 Message-ID header we stamp on the outgoing email (e.g. "<uuid@domain>").
  /// Lets inbound replies link back to this exact send via their In-Reply-To header.
  rfc822MessageId        String?
  /// e.g. mock, resend, postmark
  providerName           String?
  fromAddress            String?
  toEmail                String
  /// Normalized recipient domain for indexing
  toDomain               String?
  subject                String?
  /// Rendered/plain snapshot for ops (not for CRM)
  bodySnapshot           String?             @db.Text
  status                 OutboundEmailStatus @default(QUEUED)
  failureReason          String?
  lastErrorCode          String?
  lastErrorMessage       String?             @db.Text
  /// Last normalized provider lifecycle label (delivered, bounced, etc.)
  lastProviderEventType  String?
  /// Raw provider-reported status string when available
  providerStatus         String?
  bounceCategory         String?
  retryCount             Int                 @default(0)
  lastAttemptAt          DateTime?
  nextRetryAt            DateTime?
  /// Optional: sending mailbox identity (cap enforcement) — set when a governed mailbox is chosen for the send
  mailboxIdentityId      String?
  /// Worker claim — stale claims can be stolen after claimExpiresAt
  claimedAt              DateTime?
  claimExpiresAt         DateTime?
  /// Increments each time a worker claims this row from QUEUED → PROCESSING (idempotency scope)
  sendAttempt            Int                 @default(0)
  /// Deterministic per claim — passed to ESP Idempotency-Key when supported
  providerIdempotencyKey String?             @unique
  /// Last provider webhook / lifecycle event time applied (ordering guard)
  lastProviderEventAt    DateTime?
  /// When blocked by suppression — audit trail
  suppressionSnapshot    Json?
  queuedAt               DateTime?
  attemptedAt            DateTime?
  sentAt                 DateTime?
  deliveredAt            DateTime?
  bouncedAt              DateTime?
  openedAt               DateTime?
  metadata               Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @default(now()) @updatedAt

  client            Client                        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign          Campaign?                     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact           Contact?                      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  staffUser         StaffUser?                    @relation("OutboundInitiator", fields: [staffUserId], references: [id], onDelete: SetNull)
  mailbox           ClientMailboxIdentity?        @relation(fields: [mailboxIdentityId], references: [id], onDelete: SetNull)
  sendReservation   MailboxSendReservation?
  inboundReplies    InboundReply[]                @relation("ReplyToOutbound")
  providerEvents    OutboundProviderEvent[]
  sequenceStepSends ClientEmailSequenceStepSend[]
  unsubscribeTokens UnsubscribeToken[]

  @@index([clientId, createdAt])
  @@index([clientId, sentAt])
  @@index([clientId, status])
  @@index([contactId])
  @@index([providerMessageId])
  @@index([correlationId])
  @@index([status, nextRetryAt, queuedAt])
  @@index([mailboxIdentityId, sentAt])
  @@index([clientId, rfc822MessageId])
}

model MailboxSendReservation {
  id                String                       @id @default(cuid())
  clientId          String
  mailboxIdentityId String
  /// Deduplication scope for a booking attempt (per mailbox + UTC day in windowKey)
  idempotencyKey    String
  /// UTC date key YYYY-MM-DD (same for all users — cap resets at 00:00 UTC)
  windowKey         String
  status            MailboxSendReservationStatus @default(RESERVED)
  /// Populated when an OutboundEmail row is created for this slot
  outboundEmailId   String?                      @unique
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  client   Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  mailbox  ClientMailboxIdentity @relation(fields: [mailboxIdentityId], references: [id], onDelete: Cascade)
  outbound OutboundEmail?        @relation(fields: [outboundEmailId], references: [id], onDelete: SetNull)

  @@unique([mailboxIdentityId, windowKey, idempotencyKey])
  @@index([mailboxIdentityId, windowKey, status])
  @@index([clientId, createdAt])
}

/// Append-only provider webhook / event audit (delivery, bounce, etc.)
model OutboundProviderEvent {
  id                String   @id @default(cuid())
  clientId          String?
  outboundEmailId   String?
  providerName      String
  eventType         String
  providerMessageId String?
  /// Svix / provider message id — same replay shares id
  webhookMessageId  String?
  /// sha256 fingerprint for idempotent insert (replay detection)
  dedupeHash        String   @unique
  payload           Json?
  createdAt         DateTime @default(now())
  receivedAt        DateTime @default(now())
  /// Whether outbound row state was mutated (vs metadata-only / skipped)
  stateMutated      Boolean  @default(false)
  replayDuplicate   Boolean  @default(false)
  processingNote    String?

  client   Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  outbound OutboundEmail? @relation(fields: [outboundEmailId], references: [id], onDelete: SetNull)

  @@index([providerMessageId])
  @@index([webhookMessageId])
  @@index([outboundEmailId])
  @@index([clientId, receivedAt])
  /// Kept because it EXISTS on the live database (created by
  /// 20260416120000_outbound_queue_lifecycle). Declaring it is how the schema is
  /// reconciled to reality without running DROP INDEX on a production table.
  @@index([clientId, createdAt])
}

model InboundReply {
  id                    String             @id @default(cuid())
  clientId              String
  contactId             String?
  /// Linked outbound when match is confident and same-tenant
  linkedOutboundEmailId String?
  threadId              String?
  /// Provider's message id for this inbound message
  providerMessageId     String?
  /// In-Reply-To / References provider id we stored on outbound
  inReplyToProviderId   String?
  fromEmail             String
  toEmail               String?
  subject               String?
  snippet               String?
  bodyPreview           String?
  receivedAt            DateTime
  /// webhook | dev_simulate | polling_stub
  ingestionSource       String             @default("webhook")
  matchMethod           InboundMatchMethod @default(UNLINKED)
  metadata              Json?
  createdAt             DateTime           @default(now())

  client         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contact        Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  linkedOutbound OutboundEmail? @relation("ReplyToOutbound", fields: [linkedOutboundEmailId], references: [id], onDelete: SetNull)

  @@index([clientId, receivedAt])
  @@index([providerMessageId])
  @@index([linkedOutboundEmailId])
}

// ——— Reporting aggregates (placeholder / nightly rollups) ———
//
// DEPRECATED — no runtime path writes to this model. PR #136 made the
// Reports page read live counts only; PR #140 (G2a) removed the last
// query helpers (`getReportingSnapshotsForStaff`,
// `getDashboardSummaryForStaff`). The Prisma model is intentionally
// kept in this PR — no migration is added, no `prisma db push` or
// `migrate reset` is run, and the hard-delete cleanup scripts still
// reference the model defensively in case any historical rows exist.
//
// Schema cleanup (dropping the table) is deferred to a separately
// approved migration that an admin runs intentionally.
//
// See `docs/ops/SYSTEM_HANDOVER_GAPS.md` G2a.
model ReportingDailySnapshot {
  id              String   @id @default(cuid())
  clientId        String
  date            DateTime @db.Date
  emailsSent      Int      @default(0)
  repliesReceived Int      @default(0)
  uniqueContacts  Int      @default(0)
  campaignsActive Int      @default(0)
  replyRate       Float?
  createdAt       DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@index([clientId, date])
}

// ——— Global branding ———

/// Singleton row (id = "global") storing admin-editable global branding
/// overrides. Every column is nullable — when a column is NULL the UI
/// falls back to the static defaults in `src/lib/branding/global-brand.ts`
/// and the SVG files under `public/branding/`. Only one row is ever
/// written, keyed by `id = "global"` via upsert.
model GlobalBrandSetting {
  id             String   @id
  /// Horizontal wordmark URL rendered centered in the app header.
  appLogoUrl     String?
  /// Monogram/mark URL used for the sidebar, sign-in card, and favicon fallback.
  appMarkUrl     String?
  /// Optional favicon URL. When null, the UI falls back to `appMarkUrl`,
  /// then to the static `/branding/opensdoors-mark.svg`.
  appFaviconUrl  String?
  /// Visible brand name (e.g. "OpensDoors").
  appBrandName   String?
  /// Short product label paired with the brand name (e.g. "Outreach").
  appProductName String?
  /// Accessible alt text for the app logo. When null, the UI falls
  /// back to `"{appBrandName} {appProductName}"`.
  appLogoAltText String?
  updatedAt      DateTime @updatedAt
  /// Optional staff id that last touched the row — for audit display.
  updatedById    String?
}

// ——— Audit ———

model AuditLog {
  id          String      @id @default(cuid())
  staffUserId String?
  clientId    String?
  action      AuditAction
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime    @default(now())

  staffUser StaffUser? @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([staffUserId, createdAt])
}
