# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# generated (regenerated by `prisma generate` / postinstall)
/src/generated/prisma

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
Thumbs.db

# Azure / local tooling
.azure/
*.PublishSettings

# support-agent: dumped ticket screenshots may contain user data — never commit
.tmp/

# Sentry Config File
.env.sentry-build-plugin

# playwright / e2e
/e2e/.auth
/test-results
/playwright-report
/blob-report

# BidlowAI standards — governance artifacts (DOMAIN.json, STATE.md, GRADES.json)
# ARE tracked; the per-session marker is transient and must not be.
/.bidlow/.session-started

# CHAIN.json records the exact commit it attests to, so committing it changes
# HEAD and makes itself stale on the spot. It is a point-in-time attestation
# about a commit, not a document that lives in that commit. Kept on disk only.
/.bidlow/CHAIN.json

# Claude Code: shared project config may be committed; `.local` is per-developer
# (one person's permission allowlist) and must not travel with the repo.
.claude/settings.local.json

# Work briefs handed to the agent live outside the code repo (BidlowAI
# repository boundary). Kept locally, never committed.
GO-LIVE.md
MONDAY-PROMPT.md
